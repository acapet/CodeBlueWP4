# Scientific data and generated tables
*.nc
*.nc4
*.cdf
*.parquet
*.zarr/
*.zip

# Allow only deliberately small, reviewed regression fixtures.
!tests/fixtures/**/*.nc
!tests/fixtures/**/*.parquet

